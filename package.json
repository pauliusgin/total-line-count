{
  "name": "line-count",
  "displayName": "Line Count",
  "description": "Show active file line count and cursor location in the status bar.",
  "publisher": "pauliusgin",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pauliusgin/line-count"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "line-count.enable",
        "title": "Line Count: Enable"
      },
      {
        "command": "line-count.disable",
        "title": "Line Count: Disable"
      },
      {
        "command": "line-count.toggle",
        "title": "Line Count: Toggle"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "line-count.enable",
          "when": "!lineCount.enabled"
        },
        {
          "command": "line-count.disable",
          "when": "lineCount.enabled"
        },
        {
          "command": "line-count.toggle",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
